<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="200.0" prefWidth="376.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.vista.controlador.FormularioDevolucionController">
   <children>
      <VBox alignment="TOP_CENTER" layoutY="-4.0" prefHeight="222.0" prefWidth="376.0" spacing="20.0">
         <children>
            <Label alignment="CENTER" contentDisplay="TOP" maxHeight="1.7976931348623157E308" prefHeight="58.0" prefWidth="382.0" style="-fx-background-color: #296796;" text="Devolucion Préstamo" textFill="#fcf9f9">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_RIGHT" prefHeight="49.0" prefWidth="311.0" spacing="20.0">
               <children>
                  <Label fx:id="labelFechaPrestamo" text="Fecha devolucion Préstamo" />
                  <DatePicker fx:id="datePickerDevolucion" prefHeight="25.0" prefWidth="132.0" />
               </children>
               <VBox.margin>
                  <Insets right="10.0" />
               </VBox.margin>
            </HBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="46.0" prefWidth="291.0" spacing="20.0">
               <children>
                  <Button fx:id="botonAceptarDevolucion" mnemonicParsing="false" onAction="#oNGuardar" text="Aceptar" />
                  <Button fx:id="botonCancelarDevolucion" mnemonicParsing="false" onAction="#onCancelar" text="Cancelar" />
               </children>
               <VBox.margin>
                  <Insets left="10.0" right="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
